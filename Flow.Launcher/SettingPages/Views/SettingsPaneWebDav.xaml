<ui:Page
    x:Class="Flow.Launcher.SettingPages.Views.SettingsPaneWebDav"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewModels="clr-namespace:Flow.Launcher.SettingPages.ViewModels"
    Title="WebDAV Sync"
    d:DataContext="{d:DesignInstance viewModels:SettingsPaneWebDavViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/Resources/SettingWindowStyle.xaml" />
    </Page.Resources>
    <ui:ScrollViewerEx
        FontSize="14"
        VirtualizingStackPanel.IsVirtualizing="True"
        VirtualizingStackPanel.ScrollUnit="Pixel">

        <StackPanel Margin="5 0 24 0">
            <TextBlock
                Margin="0 23 0 10"
                FontSize="30"
                Style="{StaticResource PageTitle}"
                Text="{DynamicResource webDavSync}"
                TextAlignment="left" />

            <TextBlock
                Margin="0 0 0 14"
                Foreground="{DynamicResource Color15B}"
                Text="{DynamicResource webDavSyncDescription}"
                TextWrapping="Wrap" />

            <ui:SettingsCard
                Description="{DynamicResource webDavSyncUrlToolTip}"
                Header="{DynamicResource webDavSyncUrl}">
                <TextBox
                    Width="360"
                    IsEnabled="{Binding CanRunActions}"
                    Text="{Binding Settings.WebDavSync.Url, UpdateSourceTrigger=PropertyChanged}" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 4 0 0" Header="{DynamicResource webDavSyncUserName}">
                <TextBox
                    Width="220"
                    IsEnabled="{Binding CanRunActions}"
                    Text="{Binding Settings.WebDavSync.UserName, UpdateSourceTrigger=PropertyChanged}" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 4 0 0" Header="{DynamicResource webDavSyncPassword}">
                <PasswordBox
                    x:Name="WebDavPasswordBox"
                    Width="220"
                    IsEnabled="{Binding CanRunActions}"
                    PasswordChanged="OnPasswordChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 14 0 0" Header="{DynamicResource webDavSyncSettings}">
                <CheckBox
                    IsChecked="{Binding Settings.WebDavSync.SyncSettings}"
                    IsEnabled="{Binding CanRunActions}" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 4 0 0" Header="{DynamicResource webDavSyncPlugins}">
                <CheckBox
                    IsChecked="{Binding Settings.WebDavSync.SyncPlugins}"
                    IsEnabled="{Binding CanRunActions}" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 14 0 0" Header="{DynamicResource webDavSyncTestConnection}">
                <Button
                    MinWidth="150"
                    Command="{Binding TestConnectionCommand}"
                    Content="{DynamicResource webDavSyncTestConnection}"
                    IsEnabled="{Binding CanRunActions}" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 14 0 0" Header="{DynamicResource webDavSync}">
                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        MinWidth="110"
                        Command="{Binding UploadCommand}"
                        Content="{DynamicResource webDavSyncUpload}"
                        IsEnabled="{Binding CanRunActions}" />
                    <Button
                        MinWidth="110"
                        Command="{Binding DownloadCommand}"
                        Content="{DynamicResource webDavSyncDownload}"
                        IsEnabled="{Binding CanRunActions}" />
                    <Button
                        MinWidth="110"
                        Command="{Binding SyncCommand}"
                        Content="{DynamicResource webDavSyncSync}"
                        IsEnabled="{Binding CanRunActions}"
                        Style="{StaticResource AccentButtonStyle}" />
                </ikw:SimpleStackPanel>
            </ui:SettingsCard>

            <TextBlock
                Margin="4 16 0 0"
                Foreground="{DynamicResource Color15B}"
                Text="{Binding LastSyncDisplay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ui:ScrollViewerEx>
</ui:Page>
