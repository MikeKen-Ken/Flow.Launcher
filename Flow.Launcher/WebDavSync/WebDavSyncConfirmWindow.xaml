<Window
    x:Class="Flow.Launcher.WebDavSyncConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Flow.Launcher.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource webDavSync}"
    Width="460"
    Background="{DynamicResource PopuBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCancelExecuted" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="68" />
        </Grid.RowDefinitions>

        <controls:CustomWindowTitleBar
            Grid.Row="0"
            CloseButtonClick="OnCancelClicked"
            ShowCloseButton="True"
            ShowIcon="False"
            ShowMaximizeRestoreButton="False"
            ShowMinimizeButton="False"
            ShowTitle="False" />

        <StackPanel Grid.Row="1" Margin="30 0 30 24">
            <TextBlock
                x:Name="TitleTextBlock"
                MaxWidth="400"
                Margin="0 0 0 12"
                FontSize="20"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="MessageTextBlock"
                MaxWidth="400"
                FontSize="14"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Background="{DynamicResource PopupButtonAreaBGColor}"
            BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
            BorderThickness="0 1 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    MinWidth="140"
                    Margin="10 0 5 0"
                    Click="OnCancelClicked"
                    Content="{DynamicResource commonCancel}"
                    IsCancel="True"
                    IsDefault="True" />
                <Button
                    MinWidth="140"
                    Margin="5 0 10 0"
                    Click="OnConfirmClicked"
                    Content="{DynamicResource webDavSyncConfirmButton}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
