<UserControl
    x:Class="Flow.Launcher.SearchFilters.QueryFilterSizePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="280"
    Focusable="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SizePresetButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="Margin" Value="0 0 6 6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E3E0E3" />
            <Setter Property="Background" Value="#138A8A8A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#338A8A8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border
        Padding="12"
        Background="#2F2F2F"
        BorderBrush="#338A8A8A"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
            <TextBlock
                Margin="0 0 0 6"
                FontSize="12"
                Foreground="#8f8f8f"
                Text="{DynamicResource searchFilter_size_greaterThan}" />
            <WrapPanel>
                <Button
                    Click="OnPresetClick"
                    Content="&gt;1MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag=">1mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&gt;5MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag=">5mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&gt;10MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag=">10mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&gt;100MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag=">100mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&gt;1GB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag=">1gb" />
            </WrapPanel>
            <TextBlock
                Margin="0 4 0 6"
                FontSize="12"
                Foreground="#8f8f8f"
                Text="{DynamicResource searchFilter_size_lessThan}" />
            <WrapPanel>
                <Button
                    Click="OnPresetClick"
                    Content="&lt;1MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag="&lt;1mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&lt;10MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag="&lt;10mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&lt;100MB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag="&lt;100mb" />
                <Button
                    Click="OnPresetClick"
                    Content="&lt;1GB"
                    Style="{StaticResource SizePresetButtonStyle}"
                    Tag="&lt;1gb" />
            </WrapPanel>
            <TextBlock
                Margin="0 4 0 6"
                FontSize="12"
                Foreground="#8f8f8f"
                Text="{DynamicResource searchFilter_size_custom}" />
            <DockPanel LastChildFill="True">
                <Button
                    x:Name="ApplyCustomButton"
                    Margin="6 0 0 0"
                    Padding="10 4"
                    VerticalAlignment="Center"
                    Click="OnApplyCustomClick"
                    Content="{DynamicResource searchFilter_size_apply}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SizePresetButtonStyle}" />
                <TextBox
                    x:Name="CustomSizeBox"
                    Height="28"
                    Padding="6 2"
                    VerticalContentAlignment="Center"
                    Background="#1A1A1A"
                    BorderBrush="#338A8A8A"
                    BorderThickness="1"
                    CaretBrush="#E3E0E3"
                    Foreground="#E3E0E3"
                    PreviewKeyDown="OnCustomSizePreviewKeyDown" />
            </DockPanel>
            <TextBlock
                Margin="0 4 0 8"
                FontSize="11"
                Foreground="#8f8f8f"
                Text="{DynamicResource searchFilter_size_customHint}" />
            <Button
                HorizontalAlignment="Left"
                Click="OnClearClick"
                Content="{DynamicResource searchFilter_any}"
                Style="{StaticResource SizePresetButtonStyle}" />
        </StackPanel>
    </Border>
</UserControl>
