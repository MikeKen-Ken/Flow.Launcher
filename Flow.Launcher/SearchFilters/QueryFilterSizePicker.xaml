<UserControl
    x:Class="Flow.Launcher.SearchFilters.QueryFilterSizePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="320"
    Focusable="True"
    PreviewKeyDown="OnPreviewKeyDown"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SizePresetButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10 6" />
            <Setter Property="Margin" Value="0 0 6 6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Background" Value="{Binding ChipFill, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{Binding ChipStroke, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding ChipFillHover, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SizeBoundSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="TickPlacement" Value="BottomRight" />
            <Setter Property="Foreground" Value="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
    </UserControl.Resources>
    <Border
        Padding="14 12"
        Background="{Binding PanelFill, RelativeSource={RelativeSource AncestorType=UserControl}}"
        BorderBrush="{Binding PanelStroke, RelativeSource={RelativeSource AncestorType=UserControl}}"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel>
            <DockPanel Margin="0 0 0 2">
                <TextBlock
                    x:Name="MinValueText"
                    DockPanel.Dock="Right"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Text="{DynamicResource searchFilter_size_greaterThan}" />
            </DockPanel>
            <Slider
                x:Name="MinSlider"
                Margin="0 0 0 10"
                Style="{StaticResource SizeBoundSliderStyle}"
                Thumb.DragCompleted="OnSliderDragCompleted"
                Thumb.DragStarted="OnSliderDragStarted"
                ValueChanged="OnMinSliderValueChanged" />
            <DockPanel Margin="0 0 0 2">
                <TextBlock
                    x:Name="MaxValueText"
                    DockPanel.Dock="Right"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Text="{DynamicResource searchFilter_size_lessThan}" />
            </DockPanel>
            <Slider
                x:Name="MaxSlider"
                Margin="0 0 0 12"
                Style="{StaticResource SizeBoundSliderStyle}"
                Thumb.DragCompleted="OnSliderDragCompleted"
                Thumb.DragStarted="OnSliderDragStarted"
                ValueChanged="OnMaxSliderValueChanged" />
            <TextBlock
                Margin="0 0 0 8"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Text="{DynamicResource searchFilter_size_custom}" />
            <DockPanel LastChildFill="True">
                <Button
                    Margin="8 0 0 0"
                    VerticalAlignment="Center"
                    Click="OnApplyCustomClick"
                    Content="{DynamicResource searchFilter_size_apply}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SizePresetButtonStyle}" />
                <TextBox
                    x:Name="CustomSizeBox"
                    Height="32"
                    Padding="8 2"
                    VerticalContentAlignment="Center"
                    Background="{Binding FieldFill, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    BorderBrush="{Binding ChipStroke, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    BorderThickness="1"
                    CaretBrush="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PreviewKeyDown="OnCustomSizePreviewKeyDown" />
            </DockPanel>
            <TextBlock
                Margin="0 6 0 10"
                FontSize="11"
                Foreground="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Opacity="0.78"
                Text="{DynamicResource searchFilter_size_customHint}" />
            <Button
                HorizontalAlignment="Left"
                Click="OnClearClick"
                Content="{DynamicResource searchFilter_any}"
                Style="{StaticResource SizePresetButtonStyle}" />
        </StackPanel>
    </Border>
</UserControl>
