<UserControl
    x:Class="Flow.Launcher.SearchFilters.QueryFilterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Flow.Launcher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filters="clr-namespace:Flow.Launcher.SearchFilters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    d:DataContext="{d:DesignInstance Type=filters:QueryFilterBarViewModel}"
    Focusable="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="SearchFilterChipStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11 6" />
            <Setter Property="Margin" Value="0 0 8 8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{Binding ChipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Background" Value="{Binding ChipFill, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="BorderBrush" Value="{Binding ChipStroke, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ChipBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{Binding ChipFillHover, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{Binding ChipSelectedFill, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{Binding ChipSelectedFill, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Setter Property="Foreground" Value="{Binding ChipSelectedText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ItemsControl ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="12 6 12 10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type filters:QueryFilterItemViewModel}">
                    <Button
                        Click="OnFilterChipClick"
                        Style="{StaticResource SearchFilterChipStyle}"
                        ToolTip="{Binding Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0 0 6 0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Glyph="{Binding Glyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Text="{Binding DisplayText}" />
                            <ui:FontIcon
                                Margin="5 0 0 0"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Glyph="&#xE70D;"
                                Visibility="{Binding ShowsMenu, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Popup
            x:Name="SizePickerPopup"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False">
            <filters:QueryFilterSizePicker x:Name="SizePickerControl" />
        </Popup>
    </Grid>
</UserControl>
